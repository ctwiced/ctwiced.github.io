---
import '@fontsource-variable/inter';
import Hero from '../components/Hero.astro';
const companies = ['Conexus Credit Union', 'Think Tank Training Centre', 'TeamLinkt', 'Immigrate Software', 'Vendasta', 'Curbie Cars', 'Skyware Studios'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Chris, Product designer. Currently working on QAKoala." />
    <meta name="theme-color" content="#f8f7f2" />
    <title>chris — Product designer</title>
  </head>
  <body>
    <a class="skip" href="#work">Skip to work</a>
    <main>
      <Hero />
      <div id="work" class="work">
        <section aria-labelledby="current-title">
          <h2 id="current-title"><span class="dot active" aria-hidden="true"></span>Currently working on</h2>
          <div class="current"><p>QAKoala</p><span class="badge">Coming soon</span></div>
        </section>
        <section aria-labelledby="previous-title">
          <h2 id="previous-title"><span class="dot" aria-hidden="true"></span>Previously with</h2>
          <ul>{companies.map(company => <li>{company}</li>)}</ul>
        </section>
      </div>
    </main>
    <footer><span>chris</span><span>Product designer</span></footer>
  </body>
</html>

<style is:global>
  :root { font-family: 'Inter Variable', sans-serif; color: #292b25; background: #f8f7f2; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  main { width: min(100% - 48px, 780px); margin: auto; }
  .work { max-width: 520px; margin: auto; scroll-margin-top: 32px; }
  section + section { margin-top: 56px; }
  h2 { display: flex; align-items: center; gap: 12px; margin: 0 0 22px; font-size: 13px; font-weight: 500; color: #696b61; letter-spacing: -.015em; }
  .dot { flex: 0 0 6px; height: 6px; border-radius: 50%; background: #a6a79f; }
  .dot.active { background: #75a56c; box-shadow: 0 0 0 4px #75a56c0d, 0 0 10px #75a56c65; }
  .current { display: flex; align-items: center; gap: 14px; padding-left: 18px; flex-wrap: wrap; }
  .current p { margin: 0; font-size: 23px; letter-spacing: -.045em; font-weight: 500; }
  .badge { padding: 5px 9px; border-radius: 5px; background: #eeeee6; color: #717367; font-size: 10px; font-weight: 500; }
  ul { list-style: none; margin: 0; padding: 0 0 0 18px; display: grid; gap: 16px; }
  li { font-size: 20px; letter-spacing: -.035em; line-height: 1.4; }
  footer { width: min(100% - 48px, 520px); margin: 110px auto 36px; display: flex; justify-content: space-between; gap: 20px; color: #77796e; font-size: 11px; }
  .skip { position: absolute; top: 12px; left: 12px; padding: 12px; background: #292b25; color: white; transform: translateY(-200%); z-index: 1; }
  .skip:focus { transform: none; }
  @media (max-width: 600px) { .work { max-width: 360px; } li { font-size: 18px; } footer { margin-top: 80px; } }
</style>
