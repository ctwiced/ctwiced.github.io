---
import '@fontsource-variable/inter';
import interFontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Hero from '../components/Hero.astro';
const chatPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/chat/`;
const companies = ['Conexus Credit Union', 'Think Tank Training Centre', 'TeamLinkt', 'Immigrate Software', 'Vendasta', 'Curbie Cars', 'Skyware Studios'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="description" content="Chris, Product designer. Currently working on QAKoala." />
    <meta name="theme-color" content="#ffffff" />
    <title>chris — Product designer</title>
  </head>
  <body>
    <a class="skip" href="#work">Skip to work</a>
    <main>
      <Hero />
      <div id="work" class="work">
        <section aria-labelledby="current-title">
          <h2 id="current-title">Currently working on</h2>
          <div class="current"><a href="https://qakoala.com/">QAKoala</a></div>
        </section>
        <section aria-labelledby="previous-title">
          <h2 id="previous-title">Previously with</h2>
          <ul>{companies.map(company => <li>{company}</li>)}</ul>
        </section>
        <a class="chat-link" href={chatPath}>Let’s chat</a>
      </div>
    </main>
  </body>
</html>

<style is:global>
  :root { font-family: 'Inter Variable', sans-serif; color: #292b25; background: #ffffff; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  :root { --section-gap: 56px; }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.5; }
  main { width: min(100% - 48px, 780px); margin: auto; padding-bottom: 80px; }
  .work { max-width: 520px; margin: auto; scroll-margin-top: 32px; }
  section + section { margin-top: var(--section-gap); }
  h2 { margin: 0 0 22px; font-size: 24px; font-weight: 700; color: inherit; letter-spacing: -.035em; line-height: 1.3; }
  .current { display: grid; gap: 4px; }
  .current a { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; color: inherit; text-decoration: none; padding: 4px 12px 4px 0; border-radius: 5px; }
  .current a::after { content: ''; flex: 0 0 7px; height: 7px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
  .current a:hover, .current a:active, .current a:focus-visible { background: #f1f1ef; }
  .current a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .chat-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--section-gap); padding: 8px 16px; border-radius: 6px; background: #121212; color: #ffffff; font-weight: 600; text-decoration: none; }
  .chat-link:hover { background: #45473e; }
  .chat-link:focus-visible { outline: 2px solid #121212; outline-offset: 3px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  li, .current a { font-size: 20px; font-weight: 400; letter-spacing: -.035em; line-height: 1.4; }
  .skip { position: absolute; top: 12px; left: 12px; padding: 12px; background: #292b25; color: white; transform: translateY(-200%); z-index: 1; }
  .skip:focus { transform: none; }
  @media (max-width: 600px) { .work { max-width: 360px; } li, .current a { font-size: 18px; } h2 { font-size: 22px; } }
</style>
