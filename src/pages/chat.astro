---
import '@fontsource-variable/inter';
const homePath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const bookingUrl = 'https://calendly.com/cjjcooper/30min';
const embedUrl = `${bookingUrl}?hide_event_type_details=1&text_color=121212&primary_color=121212`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Let’s chat — Chris</title>
  </head>
  <body>
    <main>
      <header>
        <a class="back-link" href={homePath}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m10 3-5 5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Back
        </a>
        <h1>Let’s chat</h1>
        <p>Pick a time that works for you.</p>
      </header>
      <div class="calendly-inline-widget" data-url={embedUrl}></div>
      <p class="booking-fallback">Scheduler not loading? <a href={bookingUrl}>Book directly on Calendly</a>.</p>
    </main>
    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
  </body>
</html>

<style is:global>
  :root { font-family: 'Inter Variable', sans-serif; background: #ffffff; color: #121212; }
  body { margin: 0; line-height: 1.5; }
  main { width: min(calc(100% - 48px), 780px); margin: 0 auto; padding: 48px 0 64px; }
  h1 { margin: 24px 0 8px; font-size: clamp(32px, 5vw, 44px); letter-spacing: -.035em; line-height: 1.15; }
  p { margin: 0; }
  a { color: inherit; text-underline-offset: .18em; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; text-decoration: none; }
  .back-link:hover { color: #555555; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .calendly-inline-widget { width: 100%; max-width: 640px; height: 700px; margin-top: 24px; }
  .booking-fallback { margin-top: 16px; font-size: 14px; }
  @media (max-width: 367px) { main { width: 100%; } header, .booking-fallback { margin-inline: 24px; } }
</style>
