---
import '@fontsource-variable/inter';
const homePath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const bookingUrl = 'https://calendly.com/d/d2q4-mw5-nk7';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Let’s chat — Chris</title>
  </head>
  <body>
    <main>
      <header>
        <a href={homePath}>← Back to portfolio</a>
        <h1>Let’s chat</h1>
        <p>Pick a time that works for you.</p>
      </header>
      <div class="calendly-inline-widget" data-url={bookingUrl}></div>
      <p class="booking-fallback">Scheduler not loading? <a href={bookingUrl}>Book directly on Calendly</a>.</p>
    </main>
    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
  </body>
</html>

<style is:global>
  :root { font-family: 'Inter Variable', sans-serif; background: #ffffff; color: #292b25; }
  body { margin: 0; line-height: 1.5; }
  main { width: min(100%, 960px); margin: 0 auto; padding: 48px 0 64px; }
  header, .booking-fallback { margin-inline: 24px; }
  h1 { margin: 24px 0 8px; font-size: clamp(32px, 5vw, 44px); letter-spacing: -.035em; line-height: 1.15; }
  p { margin: 0; }
  a { color: inherit; text-underline-offset: .18em; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .calendly-inline-widget { width: 100%; height: 700px; margin-top: 24px; }
  .booking-fallback { margin-top: 16px; font-size: 14px; }
</style>
