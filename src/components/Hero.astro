<header class="hero">
  <h1>Chris — Product designer</h1>
  <div class="animation" data-src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/chris_hero.riv`}>
    <canvas aria-hidden="true"></canvas>
    <div class="fallback" aria-hidden="true">chris<p>Product designer</p></div>
  </div>
</header>

<script>
  import { Rive, RuntimeLoader, Layout, Fit } from '@rive-app/canvas';
  import wasmUrl from '@rive-app/canvas/rive.wasm?url';

  async function initializeHero() {
    const container = document.querySelector<HTMLElement>('.animation');
    const canvas = container?.querySelector('canvas');
    if (!container || !canvas) return;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    RuntimeLoader.setWasmUrl(wasmUrl);
    try {
      const response = await fetch(container.dataset.src!);
      if (!response.ok) throw new Error('Unable to load hero');
      const buffer = await response.arrayBuffer();
      const runtime = await RuntimeLoader.awaitInstance();
      const file = await runtime.load(new Uint8Array(buffer));
      const artboard = file.defaultArtboard();
      const animation = artboard.animationByIndex(0);
      const instance = new runtime.LinearAnimationInstance(animation, artboard);
      const animationName = animation.name;
      const endTime = (instance.workEnd > instance.workStart ? instance.workEnd : instance.duration) / instance.fps;
      container.style.aspectRatio = `${artboard.bounds.maxX - artboard.bounds.minX} / ${artboard.bounds.maxY - artboard.bounds.minY}`;
      instance.delete();
      artboard.delete();
      file.delete();
      const player = new Rive({
        buffer, canvas, autoplay: false,
        layout: new Layout({ fit: Fit.Contain }),
        onLoad() {
          player.resizeDrawingSurfaceToCanvas();
          container.classList.add('loaded');
          if (motion.matches) finish();
          else player.play(animationName);
        },
        onLoop() { finish(); },
        onLoadError() { container.classList.remove('loaded'); },
      });
      function finish() {
        player.pause(animationName);
        player.scrub(animationName, Math.max(0, endTime - 0.001));
      }
      const observer = new ResizeObserver(() => player.resizeDrawingSurfaceToCanvas());
      observer.observe(container);
      const reduceMotion = () => { if (motion.matches) finish(); };
      motion.addEventListener('change', reduceMotion);
      window.addEventListener('pagehide', () => {
        observer.disconnect();
        motion.removeEventListener('change', reduceMotion);
        player.cleanup();
      }, { once: true });
    } catch (error) {
      console.error('Hero animation unavailable', error);
    }
  }
  initializeHero();
</script>

<style>
  .hero { text-align: center; padding: 64px 0 80px; }
  .animation { position: relative; width: 100%; aspect-ratio: 2 / 1; }
  canvas { display: block; width: 100%; height: 100%; opacity: 0; }
  .loaded canvas { opacity: 1; }
  .fallback { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; font-size: clamp(100px, 19vw, 184px); letter-spacing: -.085em; }
  .loaded .fallback { display: none; }
  .fallback p { margin: 27px 0 0; font-size: 23px; letter-spacing: -.035em; color: #65645c; }
  h1 { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 600px) { .hero { padding: 40px 0 64px; } }
</style>
