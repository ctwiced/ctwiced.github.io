---
import heroWasmUrl from '@rive-app/canvas/rive.wasm?url';
import staticHero from '../../public/chris_hero_static.svg?raw';
const heroSource = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/chris_hero.riv`;
---
<link rel="preload" href={heroSource} as="fetch" crossorigin="anonymous" />
<link rel="preload" href={heroWasmUrl} as="fetch" crossorigin="anonymous" />
<header class="hero">
  <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap">Chris — Product designer</h1>
  <div class="animation" data-src={heroSource}>
    <div class="static-hero" aria-hidden="true" set:html={staticHero}></div>
    <canvas aria-hidden="true"></canvas>
  </div>
</header>

<script>
  import { Rive, RiveFile, RuntimeLoader, Layout, Fit, Alignment } from '@rive-app/canvas';
  import wasmUrl from '@rive-app/canvas/rive.wasm?url';

  async function initializeHero() {
    const container = document.querySelector<HTMLElement>('.animation');
    const canvas = container?.querySelector('canvas');
    if (!container || !canvas) return;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (motion.matches) return;
    RuntimeLoader.setWasmUrl(wasmUrl);
    try {
      const [buffer] = await Promise.all([
        fetch(container.dataset.src!).then(response => {
          if (!response.ok) throw new Error('Unable to load hero');
          return response.arrayBuffer();
        }),
        RuntimeLoader.awaitInstance(),
      ]);
      const sharedFile = new RiveFile({ buffer });
      await sharedFile.init();
      const file = sharedFile.getInstance();
      const artboard = file.defaultArtboard();
      const animation = artboard.animationByIndex(0) as ReturnType<typeof artboard.animationByIndex> & {
        duration: number;
        fps: number;
        workEnd: number;
        enableWorkArea: boolean;
      };
      const animationName = animation.name;
      const lastFrame = animation.enableWorkArea ? animation.workEnd : animation.duration;
      const endTime = Math.max(0, lastFrame - 0.01) / animation.fps;
      artboard.delete();
      const player = new Rive({
        riveFile: sharedFile, canvas, autoplay: false,
        layout: new Layout({ fit: Fit.Contain, alignment: Alignment.TopLeft }),
        onLoad() {
          player.resizeDrawingSurfaceToCanvas();
          if (motion.matches) finish();
          else {
            player.play(animationName);
            requestAnimationFrame(() => requestAnimationFrame(() => {
              if (!motion.matches) container.classList.add('loaded');
            }));
          }
        },
        onLoop() { finish(); },
        onLoadError() { container.classList.remove('loaded'); },
      });
      function finish() {
        player.pause(animationName);
        player.scrub(animationName, endTime);
      }
      const observer = new ResizeObserver(() => player.resizeDrawingSurfaceToCanvas());
      observer.observe(container);
      const reduceMotion = () => {
        if (motion.matches) {
          finish();
          container.classList.remove('loaded');
        }
      };
      motion.addEventListener('change', reduceMotion);
      window.addEventListener('pagehide', () => {
        observer.disconnect();
        motion.removeEventListener('change', reduceMotion);
        player.cleanup();
        sharedFile.cleanup();
      }, { once: true });
    } catch (error) {
      console.error('Hero animation unavailable', error);
    }
  }
  initializeHero();
</script>

<style>
  .hero { max-width: 520px; margin: auto; text-align: left; padding: 64px 0 var(--section-gap); }
  .animation { position: relative; width: min(390px, calc((100vw - 48px) / 2)); aspect-ratio: 138 / 80; transform: translateX(-4.615%); }
  .static-hero { position: absolute; inset: 0; }
  .static-hero :global(svg) { display: block; width: 100%; height: 100%; }
  .loaded .static-hero { visibility: hidden; }
  canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; opacity: 0; }
  .loaded canvas { opacity: 1; }
  @media (max-width: 600px) { .hero { max-width: 360px; padding-top: 40px; } }
</style>
